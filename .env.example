PLAY_PACKAGE_NAME=com.dotwellabs.threedollarai
FIREBASE_PROJECT_ID=your-firebase-project-id
# Entire service-account JSON on one line
GOOGLE_PLAY_SERVICE_ACCOUNT_JSON=
# At least 32 chars. Long random string (e.g. `node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"`)
PASS_SECRET=
# Any OpenAI-compatible provider (OpenAI, OpenRouter, Together, a self-hosted vLLM, ...)
UPSTREAM_BASE_URL=https://api.openai.com/v1
UPSTREAM_API_KEY=
# The one model every 3Dollar subscriber gets. Clients cannot choose another.
UPSTREAM_MODEL=gpt-4o-mini
# Optional
# PASS_TTL_SECONDS=3600
# TRUST_PROXY_HOPS=1
# RATE_LIMIT_PER_MIN=30
# REQUIRE_ACCOUNT_BINDING=true
