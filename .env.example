# Copy to .env for local runs (`npm run dev`). On Render, set these in the
# dashboard under Environment. Never commit real values.

# --- The AI endpoint this server protects --------------------------------
UPSTREAM_BASE_URL=https://genrecai-freellmapi.onrender.com/v1
UPSTREAM_API_KEY=
# Every request is sent with this model, whatever the app asks for.
UPSTREAM_MODEL=auto

# --- Passes ---------------------------------------------------------------
# Signs the passes the app holds. At least 32 random characters, e.g.
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Changing it signs every user out of the plan until their app re-checks.
PASS_SECRET=
# How long a pass lasts. A cancelled subscription keeps working this long at most.
PASS_TTL_SECONDS=86400

# --- Google Play ----------------------------------------------------------
PLAY_PACKAGE_NAME=com.dotwellabs.threedollarai
PLAY_PRODUCT_IDS=pro_monthly
# The service account key file, as one line of JSON or base64 of the file.
GOOGLE_SERVICE_ACCOUNT_JSON=

# --- Retries and timeouts -------------------------------------------------
# Tries per request to the AI endpoint, first one included. 1 turns retries off.
UPSTREAM_ATTEMPTS=3
# How long one try may take to start answering. The endpoint can need most of
# a minute to wake from sleep.
UPSTREAM_TIMEOUT_SECONDS=90
# How long all tries together may take before the app is told the AI service
# isn't responding.
UPSTREAM_DEADLINE_SECONDS=120
# First wait between tries; it doubles each time, up to the maximum.
RETRY_BASE_DELAY_MS=500
RETRY_MAX_DELAY_MS=8000
# Give up on a reply that sends nothing for this long.
STREAM_IDLE_SECONDS=180
# Largest request body. Images are sent inline, so this needs headroom.
MAX_BODY_MB=12

# --- Local testing only ---------------------------------------------------
# A made-up purchase token that is accepted without asking Google.
# Ignored when NODE_ENV=production.
# DEV_PURCHASE_TOKEN=dev-token-123
